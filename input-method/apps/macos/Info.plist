<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleExecutable</key>
	<string>qingjian-macos</string>
	<key>CFBundleIdentifier</key>
	<string>com.qiji.wordmate.inputmethod</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>WordMateInput</string>
	<key>CFBundleDisplayName</key>
	<string>WordMate 输入法</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleIconFile</key>
	<string>WordMateInput</string>
	<key>CFBundleShortVersionString</key>
	<string>0.6.0</string>
	<key>CFBundleVersion</key>
	<string>6001</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSBackgroundOnly</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<!-- InputMethodKit：连接名按 10.7 起的约定必须是 <bundle id>_Connection -->
	<key>InputMethodConnectionName</key>
	<string>com.qiji.wordmate.inputmethod_Connection</string>
	<!-- 与 imk/controller/mod.rs 里 define_class! 的 #[name] 一致 -->
	<key>InputMethodServerControllerClass</key>
	<string>WordMateInputController</string>
	<key>InputMethodType</key>
	<string>Keyboard</string>

	<!-- Text Input Sources：系统「输入法」列表里的身份 -->
	<key>TISInputSourceID</key>
	<string>com.qiji.wordmate.inputmethod</string>
	<key>TISIntendedLanguage</key>
	<string>zh-Hans</string>
	<!-- 允许系统设置里打开「用 Caps Lock 在 ABC 与WordMate 输入法之间切换」；缺省不开，WordMate 输入法自己的 Caps Lock 英文模式不变（#211） -->
	<key>TICapsLockLanguageSwitchCapable</key>
	<true/>
	<key>tsInputMethodIconFileKey</key>
	<string>qingjian-menu.pdf</string>
	<!-- 模板图：系统只取 alpha，按深浅色自动反色 -->
	<key>TISIconIsTemplate</key>
	<true/>
	<key>tsInputMethodCharacterRepertoireKey</key>
	<array>
		<string>Hans</string>
		<string>Latn</string>
	</array>

	<!-- 输入模式：系统登记、启用的是模式 com.qiji.wordmate.inputmethod.Hans，顶层 ID 是它的父项；
	显示名在 InfoPlist.strings 按模式 ID 给。约定见 docs/design/architecture.md「Info.plist 约定」 -->
	<key>ComponentInputModeDict</key>
	<dict>
		<key>tsInputModeListKey</key>
		<dict>
			<key>com.qiji.wordmate.inputmethod.Hans</key>
			<dict>
				<key>TISInputSourceID</key>
				<string>com.qiji.wordmate.inputmethod.Hans</string>
				<key>TISIntendedLanguage</key>
				<string>zh-Hans</string>
				<key>tsInputModeCharacterRepertoireKey</key>
				<array>
					<string>Hans</string>
					<string>Latn</string>
				</array>
				<!-- 必须为 false：默认启用会让模式在偏好表里没有记录的情况下就被标成
				     enabled=true，系统设置因此认为"已经加过"，既不显示在列表里、也不放进 + 列表，
				     父输入法永远无法启用（macOS 26 实测）。关掉后由用户在系统设置里手动添加。 -->
				<key>tsInputModeDefaultStateKey</key>
				<false/>
				<key>tsInputModeIsVisibleKey</key>
				<true/>
				<key>tsInputModeMenuIconFileKey</key>
				<string>qingjian-menu.pdf</string>
				<key>tsInputModeAlternateMenuIconFileKey</key>
				<string>qingjian-menu.pdf</string>
				<key>tsInputModePaletteIconFileKey</key>
				<string>qingjian-menu.pdf</string>
				<key>tsInputModePrimaryInScriptKey</key>
				<true/>
				<!-- 与可用的第三方输入法保持一致（豆包用 smSimpChinese）；
				     smUnicodeScript 不是中文输入法的常规取值 -->
				<key>tsInputModeScriptKey</key>
				<string>smSimpChinese</string>
			</dict>
		</dict>
		<key>tsVisibleInputModeOrderedArrayKey</key>
		<array>
			<string>com.qiji.wordmate.inputmethod.Hans</string>
		</array>
	</dict>
</dict>
</plist>
