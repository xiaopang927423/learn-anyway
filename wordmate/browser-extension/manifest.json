{
  "manifest_version": 3,
  "name": "WordMate 网页翻译",
  "version": "0.3.0",
  "description": "整页双语翻译、选词和段落翻译，结果直接显示在网页中。",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "WordMate 网页翻译"
  }
}
